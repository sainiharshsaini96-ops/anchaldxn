# ==============================================================================
# DXNANCHAL Product Guide - Root .gitignore
# ==============================================================================

# Node dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
*.env

# Production Build Outputs
dist/
dist-ssr/
build/
frontend/dist/
frontend/dist-ssr/
*.local

# Editor, IDE and OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs and runtime dumps
logs/
*.log
*.pid
*.seed
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
